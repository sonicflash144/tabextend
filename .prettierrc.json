{
  "printWidth": 100,
  "tabWidth": 4,
  "singleQuote": true,
  "trailingComma": "none",
  "arrowParens": "avoid",
  "endOfLine": "auto",
  "overrides": [
    {
      "files": ["*.json", "*.yml", "*.yaml", "*.html", "*.md", "webpack.config.js"],
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
